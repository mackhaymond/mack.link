/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worker",
	"main": "src/index.js",
	// Bump alongside @cloudflare/vitest-pool-workers + wrangler upgrades so
	// local Miniflare doesn't fall back to its bundled workerd date.
	// vitest-pool-workers@0.12.21 ships workerd@1.20260310.x.
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	// S1: serve the admin SPA from Cloudflare's Static Assets infrastructure
	// instead of bundling the React build into the Worker JS. `directory` is
	// resolved relative to where wrangler runs (worker/), so `../admin/dist`
	// points at the Vite output. `not_found_handling` lets deep links like
	// /admin/dashboard fall back to index.html for client-side routing.
	//
	// `run_worker_first: true` is REQUIRED here, not optional. Without it,
	// the assets binding intercepts requests BEFORE the worker handler runs,
	// which silently breaks routing in three ways:
	//   1. `/` would serve `admin/dist/index.html` (the SPA) instead of the
	//      marketing homepage rendered by routes.js -> renderHomeHtml().
	//   2. `/favicon.svg`, `/vite.svg` etc. that happen to live in
	//      `admin/dist/` would be served from the dist root rather than
	//      under `/admin/*`, polluting the public surface.
	//   3. A shortcode that collides with any file in `admin/dist/` (e.g.
	//      someone creates a `/index.html` short link) would be hijacked
	//      by the binding before handleRedirect ever sees it.
	// With `run_worker_first: true`, the worker handles ALL routing and
	// only the explicit `env.ASSETS.fetch()` call in handleAdmin exposes
	// the binding - exactly mirroring the prior embed pipeline's surface
	// area (only `/admin/*` reaches the assets).
	"assets": {
		"directory": "../admin/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mack-link",
			"database_id": "359a73e4-5445-41d3-ab10-2dc6f3bbc2f1"
		}
	],
	// B1: Native Cloudflare Rate-Limit bindings (Sprint 2b). Replaces the
	// hand-rolled counters-table limiter (`isRateLimitedPersistent` in
	// utils.js). Limits are per-Cloudflare-location (eventually consistent
	// across PoPs) and free — see SECURITY.md for the trade-off note.
	//
	// `simple.period` is restricted to 10 or 60 seconds by the binding API.
	// The previous in-DB limiter used 1-hour windows; we collapsed each
	// limit to a 60s window with a more-lenient burst budget (rather than
	// a literal 1/60th conversion that would have been too strict for
	// real admin use). Effective ceilings:
	//   - LINKS_CREATE   10/min  (was 50/hr  → ~12x more lenient sustained)
	//   - LINKS_MUTATE   30/min  (was 200/hr → ~9x  more lenient sustained)
	//   - LINKS_BULK     10/min  (was 50/hr  → ~12x more lenient sustained)
	//   - PASSWORD_VERIFY 10/min (unchanged — already 10/min per-shortcode)
	//
	// namespace_id values are account-scoped integers (as strings). They
	// must be unique per binding unless you intentionally want two
	// bindings to share counters. Picked 2001-2004 to leave 1000s free
	// for future bindings.
	"ratelimits": [
		{
			"name": "RL_LINKS_CREATE",
			"namespace_id": "2001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "RL_LINKS_MUTATE",
			"namespace_id": "2002",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "RL_LINKS_BULK",
			"namespace_id": "2003",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "RL_PASSWORD_VERIFY",
			"namespace_id": "2004",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"vars": {
		"SESSION_MAX_AGE": "28800",
		"SESSION_COOKIE_NAME": "__Host-link_session",
		"ALLOWED_ORIGINS": "https://link.mackhaymond.co",
		"ALLOWED_REDIRECT_URIS": "https://link.mackhaymond.co/admin/auth/callback",
		"ANALYTICS_RETENTION_DAYS": "365",
		"TEAM_DOMAIN": "https://mackhaymond.cloudflareaccess.com",
		"POLICY_AUD": "fbbe26349cce35544854c354d84048ea31952d9a4dec9975c7a550d27f128f3e"
	},
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	// Staging env — local-only since the PR preview pipeline was removed.
	// Originally introduced as Sprint 1 (H22 + S3) for CI-driven PR previews;
	// that workflow is gone. The env block is kept so the staging Worker
	// (`worker-staging.<subdomain>.workers.dev`) + staging D1
	// (`mack-link-staging`) remain usable for ad-hoc local testing via:
	//   - `wrangler dev --env staging`
	//   - `wrangler deploy --env staging` (manual, from a dev machine)
	//   - `D1_DATABASE_NAME=mack-link-staging npm -w worker run db:apply`
	//
	// If you decide you don't need the staging Worker at all, you can
	// delete the whole `env.staging` block, then run:
	//   wrangler delete --name worker-staging --force
	//   wrangler d1 delete mack-link-staging --force
	//
	// Staging runs in auth-bypass mode (AUTH_DISABLED=true +
	// ENVIRONMENT=development) so you can hit it without going through
	// Cloudflare Access. The runtime dev-auth defense-in-depth check
	// (Host must be localhost/127.0.0.1) is intentionally bypassed in
	// staging via the env flags — staging is itself a non-prod environment.
	"env": {
		"staging": {
			"name": "worker-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mack-link-staging",
					"database_id": "ca9836da-1d7d-4c79-99cd-5c2734327b64"
				}
			],
			// B1: Staging gets its own rate-limit namespaces (3001-3004) so
			// burst PR-preview traffic doesn't share counters with prod.
			// Same limits as prod since the binding is free regardless of
			// namespace count.
			"ratelimits": [
				{
					"name": "RL_LINKS_CREATE",
					"namespace_id": "3001",
					"simple": { "limit": 10, "period": 60 }
				},
				{
					"name": "RL_LINKS_MUTATE",
					"namespace_id": "3002",
					"simple": { "limit": 30, "period": 60 }
				},
				{
					"name": "RL_LINKS_BULK",
					"namespace_id": "3003",
					"simple": { "limit": 10, "period": 60 }
				},
				{
					"name": "RL_PASSWORD_VERIFY",
					"namespace_id": "3004",
					"simple": { "limit": 10, "period": 60 }
				}
			],
			"assets": {
				"directory": "../admin/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"html_handling": "auto-trailing-slash",
				"run_worker_first": true
			},
			"vars": {
				"AUTH_DISABLED": "true",
				"ENVIRONMENT": "development",
				"SESSION_ALLOW_INSECURE_COOKIES": "false",
				"SESSION_MAX_AGE": "28800",
				"SESSION_COOKIE_NAME": "__Host-link_session",
				"ALLOWED_ORIGINS": "https://worker-staging.<your-subdomain>.workers.dev",
				"ALLOWED_REDIRECT_URIS": "https://worker-staging.<your-subdomain>.workers.dev/admin/auth/callback",
				"ANALYTICS_RETENTION_DAYS": "30",
				"TEAM_DOMAIN": "https://mackhaymond.cloudflareaccess.com",
				"POLICY_AUD": "fbbe26349cce35544854c354d84048ea31952d9a4dec9975c7a550d27f128f3e"
			}
		}
	}
}
