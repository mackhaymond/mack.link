# Node modules
node_modules/
**/node_modules/

# Build outputs
**/dist/
**/dist-ssr/
# Workspace lockfiles (monorepo uses root lockfile)
worker/package-lock.json
admin/package-lock.json

# OS files
.DS_Store

# Wrangler
**/.wrangler/

# Env files
.env
**/.env.local

# Local agent settings (per-user, never committed)
.claude/
**/.claude/
.opencode/
**/.opencode/
**/.claude/settings.local.json

# Per-workspace dist (built output of @mack-link/shared, etc.)
packages/*/dist/
